# Plumbline API configuration. Copy to .env and fill in.

# Postgres / Supabase connection string (Supabase → Project → Database → URI)
DATABASE_URL=postgres://user:password@host:5432/plumbline
# Set PGSSL=disable for a local Postgres without TLS
# PGSSL=disable

# Signs the session cookie — use a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string

# LLM interaction layer — the key lives ONLY here, never in the browser.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# NODE_ENV=production   # enables Secure cookies
# PORT=8080
